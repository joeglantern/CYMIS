# Copy to .env for local work. Never commit a real .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Comma separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set to true when the API sits behind Caddy or another proxy.
TRUST_PROXY=false

DATABASE_URL=postgresql://cymis:cymis_dev_password@127.0.0.1:5470/cymis
REDIS_URL=redis://127.0.0.1:6470

# Make each secret at least 32 random characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_change_me_dev_only_change_me_dev_only
COOKIE_SECRET=dev_only_cookie_secret_change_me_dev_only_cookie
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

S3_ENDPOINT=http://127.0.0.1:8470
S3_REGION=us-east-1
S3_BUCKET=cymis-dev
S3_ACCESS_KEY_ID=cymis_dev_access
S3_SECRET_ACCESS_KEY=cymis_dev_secret_key_change_me
S3_FORCE_PATH_STYLE=true
# Optional. Public address phones use for uploads, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# Upload limits
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=50000

# Seed (local only)
SEED_ADMIN_STAFF_ID=ADMIN
SEED_ADMIN_PASSWORD=change me on first sign in

# Run imports, reports and CV results inside the API process (local only).
WORKERS_IN_PROCESS=true

# Demo data (local only): node scripts/demo-data.mjs
DEMO_PASSWORD=yard crew demo 2026
