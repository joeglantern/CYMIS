{
  "name": "cymis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm build:packages && pnpm --filter @cymis/api run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm build:packages && pnpm -r run test",
    "check:text": "node scripts/check-text.mjs",
    "check": "pnpm check:text && pnpm lint && pnpm typecheck && pnpm test",
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "dev": "pnpm build:packages && pnpm --filter @cymis/api run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
