{
  "name": "@cymis/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and types shared by the API and the apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cymis/iso6346": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cymis/tsconfig": "workspace:*"
  }
}
