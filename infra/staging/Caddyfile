{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	@api path /api/* /socket.io/* /health/*
	handle @api {
		reverse_proxy api:4000
	}

	# Code files are named by their content. A missing one is a 404, never the
	# page, so an old tab gets a clean error it can recover from by reloading.
	handle /_expo/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}
